      "name": "Enterprise Security Platform Integration",
      "description": "整合外部資安平台工作流 (DefectDojo, Faraday, Wazuh, ZAP, Post-merge security)",
      "githubWorkflows": [
        "defectdojo-upload.yml",
        "faraday-upload.yml",
        "wazuh-health.yml",
        "zap-scan.yml",
        "post-merge-security.yml"
