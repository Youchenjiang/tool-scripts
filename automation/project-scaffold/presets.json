  "features": {
    "strict-linting": {
      "name": "Strict Code Quality (ESLint Flat Config)",
      "description": "本地嚴格代碼品質守門員 (ESLint flat config，禁 ! 非空斷言、禁單字母變數、禁巢狀三元、class 方法 static 檢查)",
      "lintFiles": [
        "eslint.config.mjs"
      ],
      "npmDevDeps": [
        "eslint",
        "@eslint/js",
        "@typescript-eslint/parser",
        "@typescript-eslint/eslint-plugin"
      ]
    },
    "chained-prs": {
      "name": "Chained / Stacked PR Workflow Guidelines",
      "description": "注入滾動 Rebase 串接 PR 規範與 GitHub Ruleset / Push 判斷防護指引",
      "agentRules": [
        "chained-prs.md"
      ]
    },
