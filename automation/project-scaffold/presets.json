{
  "defaults": {
    "coreRules": [
      "core.md",
      "deliberation-gate.md",
      "memory-protocol.md"
    ],
    "coreGitFiles": [
      ".gitignore",
      ".gitmessage.txt",
      ".editorconfig",
      "hooks/commit-msg",
      "hooks/pre-push"
    ],
    "coreTools": [
      "lint_commits.py",
      "build_runner.py",
      "release_checker.py",
      "bump_version.py",
      "repo_hygiene.py",
      "file_lines.py",
      "architecture_graph.py"
    ],
    "prTools": [
      "pr_helper.py",
      "branch_policy.py",
      "process_guard.py",
      "gh_guard.py",
      "sonar_audit.py",
      "pr_audit.py",
      "pr_reports.py",
      "pr_verification.py",
      "pr_body_contract.py",
      "pr_preflight.py",
      "pr_publication.py",
      "pr_creation.py",
      "pr_tool.py"
    ],
    "coreGithubWorkflows": [
      "ci.yml",
      "policy.yml",
      "trufflehog.yml",
      "codeql.yml"
    ],
    "coreGithubFiles": [
      "pull_request_template.md",
      "SECURITY.md"
    ]
  },
  "archetypes": {
    "web-spa": {
      "name": "Web SPA / Frontend",
      "flow": "pr",
      "ecosystem": "node",
      "build": {
        "lint": "npm run lint",
        "test": "npm test",
        "build": "npm run build"
      },
      "release": {
        "strategy": "npm-version",
        "versionFile": "package.json",
        "syncFiles": [
          "package-lock.json"
        ]
      },
      "description": "Web / Frontend SPA / React / Vite / Ionic 靜態發布應用 (如 Wildwatch, 零後端應用)",
      "defaultScopes": [
        "core",
        "app",
        "ui",
        "style",
        "render",
        "sim",
        "test",
        "docs",
        "ci",
        "deps",
        "spec",
        "rules",
        "setup",
        "quality",
        "agent",
        "chore"
      ],
      "agentRules": [
        "git-discipline.md",
        "web-guidelines.md"
      ],
      "githubFiles": [
        "dependabot.yml"
      ],
      "recommendedFeatures": [
        "strict-linting",
        "chained-prs"
      ]
    },
    "backend-python": {
      "name": "Backend Python / FastAPI Service",
      "flow": "pr",
      "ecosystem": "python",
      "build": {
        "lint": "python -m ruff check .",
        "test": "python -m unittest discover -s tests -p \"test_*.py\"",
        "build": "python -m build"
      },
      "release": {
        "strategy": "python-version",
        "versionFile": "pyproject.toml",
        "syncFiles": []
      },
      "description": "Python 服務端全端 / FastAPI / Django / Flask 現代化後端 (0% Node.js 污染)",
      "defaultScopes": [
        "core",
        "api",
        "auth",
        "db",
        "service",
        "middleware",
        "config",
        "test",
        "deps",
        "docs",
        "ci",
        "setup",
        "agent",
        "chore"
      ],
      "agentRules": [
        "git-discipline.md"
      ],
      "githubWorkflows": [
        "sbom.yml"
      ],
      "githubFiles": [
        "dependabot.yml"
      ],
      "recommendedFeatures": [
        "conda-env"
      ]
    },
    "backend-node": {
      "name": "Backend Node.js / Express / Nest Service",
      "flow": "pr",
      "ecosystem": "node",
      "build": {
        "lint": "npm run lint",
        "test": "npm test",
        "build": "npm run build"
      },
      "release": {
        "strategy": "npm-version",
        "versionFile": "package.json",
        "syncFiles": [
          "package-lock.json"
        ]
      },
      "description": "Node.js / TypeScript / Express / NestJS 服務端全端應用",
      "defaultScopes": [
        "core",
        "api",
        "auth",
        "db",
        "service",
        "middleware",
        "config",
        "test",
        "deps",
        "docs",
        "ci",
        "setup",
        "agent",
        "chore"
      ],
      "agentRules": [
        "git-discipline.md"
      ],
      "githubWorkflows": [
        "sbom.yml"
      ],
      "githubFiles": [
        "dependabot.yml"
      ],
      "recommendedFeatures": [
        "strict-linting"
      ]
    },
    "desktop-app": {
      "name": "Desktop Application",
      "flow": "pr",
      "ecosystem": "dotnet",
      "build": {
        "lint": "dotnet format --verify-no-changes",
        "test": "dotnet test",
        "build": "dotnet build -c Release"
      },
      "release": {
        "strategy": "dotnet-store",
        "versionFile": "Directory.Build.props",
        "syncFiles": [
          "Package.appxmanifest"
        ]
      },
      "description": "Windows / .NET / WinUI / C# / Tauri 桌面端應用 (如 Tapster, Clickra)",
      "defaultScopes": [
        "core",
        "shell",
        "ui",
        "native",
        "msix",
        "store",
        "test",
        "deps",
        "docs",
        "ci",
        "setup",
        "agent",
        "chore"
      ],
      "agentRules": [
        "git-discipline.md",
        "dotnet-hygiene.md",
        "store-release.md"
      ],
      "githubWorkflows": [
        "sbom.yml"
      ],
      "githubFiles": [
        "dependabot.yml"
      ],
      "recommendedFeatures": [
        "chained-prs",
        "msix-packaging",
        "architecture-guard"
      ]
    },
    "sec-research": {
      "name": "Security Research / PoC",
      "flow": "pr",
      "ecosystem": "python",
      "build": {
        "lint": "python -m flake8",
        "test": "python -m unittest discover -s tests",
        "build": ""
      },
      "release": {
        "strategy": "python-version",
        "versionFile": "pyproject.toml",
        "syncFiles": []
      },
      "description": "資安研究 / 漏洞分析 / 概念驗證 PoC / 腳本庫 / 知識庫 (如 sec-compendium)",
      "defaultScopes": [
        "core",
        "poc",
        "vuln",
        "exploit",
        "report",
        "scanner",
        "data",
        "test",
        "deps",
        "docs",
        "ci",
        "setup",
        "agent",
        "chore"
      ],
      "agentRules": [
        "git-discipline.md"
      ],
      "gitFiles": [
        ".pr_agent.toml"
      ],
      "githubWorkflows": [
        "nuclei-scan.yml",
        "pr_agent.yml",
        "sbom.yml"
      ],
      "recommendedFeatures": [
        "conda-env"
      ]
    },
    "minimal": {
      "name": "Minimal Utility",
      "flow": "pr",
      "ecosystem": "generic",
      "build": {
        "lint": "",
        "test": "",
        "build": ""
      },
      "release": {
        "strategy": "github-tag",
        "versionFile": "VERSION",
        "syncFiles": []
      },
      "description": "極簡小工具 / 輕量腳本庫 / 快速原型",
      "defaultScopes": [
        "core",
        "tool",
        "test",
        "deps",
        "docs",
        "ci",
        "setup",
        "agent",
        "chore"
      ],
      "agentRules": [
        "git-discipline.md"
      ],
      "githubWorkflows": [],
      "recommendedFeatures": [
        "conda-env"
      ]
    },
    "script-tool": {
      "name": "Script Repository / Utility Monorepo",
      "flow": "direct-push",
      "ecosystem": "generic",
      "includePrTools": false,
      "includePrGithubFiles": false,
      "build": {
        "lint": "",
        "test": "",
        "build": ""
      },
      "release": {
        "strategy": "github-tag",
        "versionFile": "VERSION",
        "syncFiles": []
      },
      "description": "腳本庫 / 個人工具集 / 單元腳本 Monorepo (如 tool-scripts，免開 PR、主幹原子直接推送)",
      "defaultScopes": [
        "core",
        "automation",
        "data",
        "media",
        "text",
        "security",
        "ai",
        "cli",
        "test",
        "deps",
        "docs",
        "ci",
        "setup",
        "catalog",
        "agent",
        "chore"
      ],
      "agentRules": [
        "direct-trunk.md"
      ],
      "githubFiles": [
        "dependabot.yml"
      ],
      "recommendedFeatures": [
        "direct-push"
      ]
    }
  },
  "features": {
    "strict-linting": {
      "name": "Strict Code Quality (ESLint Flat Config)",
      "description": "本地嚴格代碼品質守門員 (ESLint flat config，禁 ! 非空斷言、禁單字母變數、禁巢狀三元、class 方法 static 檢查)",
      "lintFiles": [
        "eslint.config.mjs"
      ],
      "npmDevDeps": [
        "eslint",
        "@eslint/js",
        "@typescript-eslint/parser",
        "@typescript-eslint/eslint-plugin"
      ]
    },
    "chained-prs": {
      "name": "Chained / Stacked PR Workflow Guidelines",
      "description": "注入滾動 Rebase 串接 PR 規範與 GitHub Ruleset / Push 判斷防護指引",
      "agentRules": [
        "chained-prs.md"
      ]
    },
    "sec-enterprise": {
      "name": "Enterprise Security Platform Integration",
      "description": "整合外部資安平台工作流 (DefectDojo, Faraday, Wazuh, ZAP, Nuclei, Post-deploy security)",
      "githubWorkflows": [
        "nuclei-scan.yml",
        "defectdojo-upload.yml",
        "faraday-upload.yml",
        "wazuh-health.yml",
        "zap-scan.yml",
        "post-merge-security.yml"
      ]
    },
    "direct-push": {
      "name": "Direct Trunk Push (免 PR 主幹直接推播)",
      "description": "適用個人腳本庫、工具集與 Monorepo (如 tool-scripts)，免開 PR，以原子化提交直接推送到 main 主幹",
      "agentRules": [
        "direct-trunk.md"
      ]
    },
    "conda-env": {
      "name": "Conda / Mamba Environment Manager",
      "description": "自動產生現代化 environment.yml (Python 3.14 + Mamba/GPU 最佳化) 並注入 env_tool.py 與驗證測試",
      "agentRules": [
        "conda-hygiene.md"
      ]
    },
    "git-worktree": {
      "name": "Git Worktree Parallel Workflow",
      "description": "獨立 Worktree 目錄並行開發與安全清理工具 (防依賴污染、防意外刪除未合併代碼)",
      "agentRules": [
        "git-worktree.md"
      ],
      "toolFiles": [
        "worktree_tool.py"
      ]
    },
    "architecture-guard": {
      "name": "Layered Architecture & Code Metrics",
      "description": "逐層相依拓撲分析、循環依賴檢測、單檔行數門禁與架構規範",
      "agentRules": [
        "layered-architecture.md"
      ]
    },
    "msix-packaging": {
      "name": "Windows MSIX Packaging & Code Signing Suite",
      "description": "Windows 桌面應用程式自簽發行憑證生成、本機受信任安裝、以及 MSIX Authenticode 簽章與發行者對齊驗證門禁",
      "agentRules": [
        "store-release.md"
      ],
      "toolFiles": [
        "create_dev_cert.ps1",
        "verify_msix_signature.ps1"
      ]
    },
    "bot-pr-exempt": {
      "name": "Bot PR exemption from the PR body contract",
      "description": "自動化帳號（dependabot[bot]、github-actions[bot] 等）開的 PR 跳過 PR body 章節與 provider 勾選檢查；人手開的 PR 仍受完整檢查"
    }
  },
  "legacyAliases": {
    "backend-api": "backend-python",
    "backend": "backend-python",
    "backend-py": "backend-python",
    "backend-js": "backend-node",
    "desktop": "desktop-app",
    "web": "web-spa",
    "research": "sec-research",
    "minimal": "minimal",
    "script": "script-tool",
    "scripts": "script-tool",
    "tools": "script-tool",
    "tool": "script-tool"
  }
}
